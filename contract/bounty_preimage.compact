// Private Bounties: the preimage template.
//
// A poster escrows a shielded reward and asks for an answer whose hash is a
// target. A solver proves their answer passes, and in the same transaction the
// answer is stored encrypted to the poster's key and the reward is paid to the
// solver. Only the poster can decrypt. After the deadline, an unsolved
// bounty's reward goes back to the poster.
//
// See ARCHITECTURE.md. Each template contract hosts many bounties; the shared
// logic lives in the modules imported below.

pragma language_version 0.23;
import CompactStandardLibrary;
import "escrow" prefix Escrow_;
import "deadline" prefix Deadline_;
import "pseudonym" prefix Pseudonym_;
import "ecdh" prefix Ecdh_;
import "stream_cipher" prefix Cipher_;

export enum Status { OPEN, SOLVED, REFUNDED }

export struct Bounty {
  poster: Bytes<32>;        // per-bounty pseudonym, not the wallet
  posterPk: JubjubPoint;    // the poster's encryption key, b·G
  target: Field;            // the checker's public parameter
  deadline: Uint<64>;       // block time, seconds since the Unix epoch
  status: Status;
}

export struct Delivery {
  ephemeralPk: JubjubPoint; // e·G, for the poster's side of the key exchange
  c: Vector<4, Field>;      // the answer, encrypted to the poster
}

// What the board shows. Public, written once when the bounty is posted and
// never changed. Nothing checks the text; the reward is the escrowed coin's
// value, and the post time is checked against block time.
export struct Listing {
  title: Opaque<"string">;
  details: Opaque<"string">; // for this template, the question
  reward: Uint<128>;        // the reward as posted, still readable once it's paid out
  postedAt: Uint<64>;       // when it was posted: block time, to within 15 minutes
}

// The token rewards are paid in, the smallest reward, and how long a bounty
// must stay open. Set once, at deploy time. The last two make spam lock up
// capital for a while (second audit, L1).
export sealed ledger rewardColor: Bytes<32>;
export sealed ledger minReward: Uint<128>;
export sealed ledger minWindow: Uint<64>;
export ledger bounties: Map<Bytes<32>, Bounty>;
// Kept apart from `bounties`, which `submit` and `refund` rewrite, so the text
// is only written once.
export ledger listings: Map<Bytes<32>, Listing>;
// Open bounty: the reward coin is public, because whoever solves it has to be
// able to spend it. It is a fresh coin, so its nonce points at nobody.
export ledger escrows: Map<Bytes<32>, QualifiedShieldedCoinInfo>;
export ledger deliveries: Map<Bytes<32>, Delivery>;

// The poster's identity secret. Separate from the encryption key `b`, which
// never enters a circuit.
witness localSecretKey(): Bytes<32>;
// The solver's answer.
witness answer(): Vector<4, Field>;
// Fresh for every submission. 248 bits keeps it below the Jubjub order.
witness ephemeralScalar(): Uint<248>;

constructor(color: Bytes<32>, minimumReward: Uint<128>, minimumWindow: Uint<64>) {
  rewardColor = disclose(color);
  minReward = disclose(minimumReward);
  minWindow = disclose(minimumWindow);
}

// The checker for this template.
pure circuit passes(m: Vector<4, Field>, target: Field): Boolean {
  return transientHash<Vector<4, Field>>(m) == target;
}

// ---- Off-chain helpers: the UI calls these so it uses the circuit's math. ----

export pure circuit answerHash(m: Vector<4, Field>): Field {
  return transientHash<Vector<4, Field>>(m);
}

export pure circuit checkAnswer(m: Vector<4, Field>, target: Field): Boolean {
  return passes(m, target);
}

export pure circuit posterPublicKey(b: Field): JubjubPoint {
  return Ecdh_publicKey(b);
}

// The poster's side of the key exchange, then decryption.
export pure circuit decrypt(d: Delivery, b: Field, id: Bytes<32>): Vector<4, Field> {
  const context = degradeToTransient(id);
  return Cipher_decrypt4(d.c, Ecdh_sharedKey(b, d.ephemeralPk, context), context);
}

// A bounty's ID from the poster's salt and secret key (second audit, L3).
export pure circuit bountyIdFor(salt: Bytes<32>, sk: Bytes<32>): Bytes<32> {
  return Pseudonym_bountyId(salt, sk);
}

// ---- Circuits ----

export circuit postBounty(salt: Bytes<32>, reward: ShieldedCoinInfo, posterPk: JubjubPoint,
                          target: Field, deadline: Uint<64>,
                          title: Opaque<"string">, details: Opaque<"string">,
                          postedAt: Uint<64>): [] {
  const sk = localSecretKey();
  const bountyId = disclose(Pseudonym_bountyId(salt, sk));
  assert(!bounties.member(bountyId), "Bounty already exists");
  Deadline_assertOpen(disclose(deadline));
  Deadline_assertRecent(disclose(postedAt));
  Deadline_assertWindow(disclose(postedAt), disclose(deadline), minWindow);
  Ecdh_assertValidPublicKey(disclose(posterPk));

  assert(disclose(reward.value) > 0, "Reward has no value");
  assert(disclose(reward.value) >= minReward, "Reward is below the minimum");
  Escrow_receiveFresh(reward, rewardColor);
  escrows.insertCoin(bountyId, disclose(reward), right<ZswapCoinPublicKey, ContractAddress>(kernel.self()));
  bounties.insert(bountyId, Bounty {
    poster: disclose(Pseudonym_derive(pad(32, "bounty:poster"), bountyId, sk)),
    posterPk: disclose(posterPk),
    target: disclose(target),
    deadline: disclose(deadline),
    status: Status.OPEN
  });
  listings.insert(bountyId, Listing {
    title: disclose(title), details: disclose(details),
    reward: disclose(reward.value), postedAt: disclose(postedAt)
  });
}

// One transaction for the solver: the checker, the encrypted delivery and the
// payout. `stake` is a fresh coin of the solver's own, and may be worth zero;
// it is merged first, so the payout (reward plus the stake back) can't be
// linked to the solver.
export circuit submit(id: Bytes<32>, stake: ShieldedCoinInfo): [] {
  const bountyId = disclose(id);
  assert(bounties.member(bountyId), "No such bounty");
  const b = bounties.lookup(bountyId);
  assert(b.status == Status.OPEN, "Bounty is closed");
  Deadline_assertOpen(b.deadline);

  const m = answer();
  assert(passes(m, b.target), "Wrong answer");

  const context = degradeToTransient(bountyId);
  const e = ephemeralScalar() as Field;
  deliveries.insert(bountyId, Delivery {
    ephemeralPk: disclose(Ecdh_publicKey(e)),
    c: disclose(Cipher_encrypt4(m, Ecdh_sharedKey(e, b.posterPk, context), context))
  });

  const first = Escrow_receiveFresh(stake, rewardColor);
  Escrow_payMerged(first, escrows.lookup(bountyId), ownPublicKey());

  bounties.insert(bountyId, Bounty {
    poster: b.poster, posterPk: b.posterPk, target: b.target, deadline: b.deadline, status: Status.SOLVED
  });
  escrows.remove(bountyId);
}

// After the deadline, the poster takes back the reward of an unsolved bounty.
export circuit refund(id: Bytes<32>): [] {
  const bountyId = disclose(id);
  assert(bounties.member(bountyId), "No such bounty");
  const b = bounties.lookup(bountyId);
  assert(b.status == Status.OPEN, "Bounty is closed");
  assert(b.poster == disclose(Pseudonym_derive(pad(32, "bounty:poster"), bountyId, localSecretKey())),
         "Only the poster can refund");
  Deadline_assertExpired(b.deadline);

  Escrow_payOut(escrows.lookup(bountyId), ownPublicKey());
  bounties.insert(bountyId, Bounty {
    poster: b.poster, posterPk: b.posterPk, target: b.target, deadline: b.deadline, status: Status.REFUNDED
  });
  escrows.remove(bountyId);
}

// Diffie-Hellman key exchange on the Jubjub curve, for Private Bounties.
//
// This file is a MODULE: `import "ecdh" prefix Ecdh_;`.
//
// Scalars must be below the Jubjub order (about 2^252); a 248-bit witness is
// always in range. JubjubPoint is opaque, so read it with jubjubPointX/Y.

module ecdh {
  import CompactStandardLibrary;

  // The public key for secret scalar `sk`.
  export pure circuit publicKey(sk: Field): JubjubPoint {
    return ecMulGenerator(sk);
  }

  // The shared key between scalar `sk` and someone's public key `pk`, hashed
  // to one field element and bound to `context`. Both sides get the same
  // value: the solver from (e, posterPk), the poster from (b, e·G).
  export pure circuit sharedKey(sk: Field, pk: JubjubPoint, context: Field): Field {
    const s = ecMul(pk, sk);
    return transientHash<Vector<4, Field>>(["pb:ecdh" as Field, jubjubPointX(s), jubjubPointY(s), context]);
  }
}

// Deadline checks for Private Bounties. Block time is in seconds since the
// Unix epoch (verified in spike Q7).
//
// This file is a MODULE: `import "deadline" prefix Deadline_;`.

module deadline {
  import CompactStandardLibrary;

  // Passes while the block time is before `deadline`.
  export circuit assertOpen(deadline: Uint<64>): [] {
    assert(blockTimeLt(deadline), "Deadline has passed");
  }

  // Passes once the block time has reached `deadline`.
  export circuit assertExpired(deadline: Uint<64>): [] {
    assert(blockTimeGte(deadline), "Deadline has not passed");
  }

  // Passes when `t` is the block time or up to 15 minutes before it. A poster
  // passes the time they post at; the 15 minutes cover proving, approval in
  // the wallet and landing in a block.
  export circuit assertRecent(t: Uint<64>): [] {
    assert(blockTimeGte(t), "Post time is in the future");
    assert(blockTimeLt((t + 900) as Uint<64>), "Post time is too old");
  }

  // Passes when `deadline` is at least `window` seconds after `start`.
  export circuit assertWindow(start: Uint<64>, deadline: Uint<64>, window: Uint<64>): [] {
    assert(deadline >= (start + window) as Uint<64>, "Deadline is too soon");
  }
}

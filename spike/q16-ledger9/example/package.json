{
  "name": "@midnight-ntwrk/example-pb-q16",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "cd contract && compact compile +0.36.0 test_token.compact managed/test_token && compact compile +0.36.0 bounty_preimage.compact managed/bounty_preimage && compact compile +0.36.0 --skip-zk bounty_signed_record.compact managed/bounty_signed_record",
    "compile:fast": "cd contract && compact compile +0.36.0 --skip-zk test_token.compact managed/test_token && compact compile +0.36.0 --skip-zk bounty_preimage.compact managed/bounty_preimage && compact compile +0.36.0 --skip-zk bounty_signed_record.compact managed/bounty_signed_record",
    "typecheck": "tsc --noEmit -p .",
    "test": "NODE_OPTIONS='--experimental-vm-modules' vitest run --exclude 'src/**/*.sim.test.ts'",
    "test:sim": "vitest run --passWithNoTests .sim.test.ts",
    "test:local": "MIDNIGHT_NETWORK=local npm test --",
    "test:preview": "MIDNIGHT_NETWORK=preview npm test --",
    "test:preprod": "MIDNIGHT_NETWORK=preprod npm test --",
    "test:custom": "MIDNIGHT_NETWORK=custom npm test --",
    "env:up": "docker compose up -d --wait",
    "env:down": "docker compose down",
    "proof:up": "docker compose up -d --wait proof-server",
    "proof:down": "docker compose stop proof-server"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "5.0.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-network-id": "5.0.0-rc.5",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.0",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.0",
    "@midnight-ntwrk/midnight-js-types": "5.0.0",
    "@midnight-ntwrk/midnight-js-utils": "5.0.0",
    "@midnight-ntwrk/testkit-js": "5.0.0",
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "typescript": "^5.7.0",
    "vite": "6.4.4",
    "vite-node": "^6.0.0",
    "vitest": "^5.0.4"
  }
}
